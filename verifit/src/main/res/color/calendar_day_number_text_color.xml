<?xml version="1.0" encoding="utf-8"?>
<!-- Text color for one day number in CalendarPickerDialog: calendar_day_selected_text on the selected day's
     filled circle (see calendar_day_number_background.xml; blanc en clair, sombre en nuit),
     core_black otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/calendar_day_selected_text" android:state_selected="true" />
    <item android:color="@color/core_black" />
</selector>
