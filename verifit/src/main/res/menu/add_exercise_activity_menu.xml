<?xml version="1.0" encoding="utf-8"?>
<!-- Retour Romain 07/09/2026 : "je vois le nom de l'exercice en cours [...] il est
     tronque [...] la un ai 2 lettres [...] cet affichage devrait etre prioritaire
     (surtout par rapport a la liste d'icones. je n'aime pas les listes d'icones en
     general)". Cause : les 6 items ci-dessous etaient tous en
     app:showAsAction="always", ne laissant presque plus de place au titre
     (AddExerciseActivity.initActivity(), getSupportActionBar().setTitle(exercise_name))
     dans la barre d'action. Passes en "never" : ils rejoignent le menu "..." standard
     (un seul icone), le titre recupere toute la largeur disponible. android:title
     ajoute sur les 4 items qui n'en avaient pas (invisibles jusqu'ici car
     app:showAsAction="always" affiche l'icone seule - le menu "..." lui affiche le
     texte, pas l'icone). -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <item
        android:id="@+id/history"
        android:icon="@drawable/ic_settings_backup_restore_24px"
        android:title="Exercise History"
        app:showAsAction="never"
        app:iconTint="@color/cardview_light_background">
    </item>

    <item
        android:id="@+id/graph"
        android:icon="@drawable/ic_poll_24px"
        android:title="Graph"
        app:showAsAction="never"
        app:iconTint="@color/cardview_light_background">
    </item>

    <!-- Retour Romain 06/09/2026 : "je voudrai pouvoir y acceder depuis la fiche de
         l'exercice [...] un petit trophee comme sur fitnotes qui m'amene vers mon
         tableau de PR" - ouvre RepRangeRecordsActivity pour l'exercice en cours (voir
         AddExerciseActivity.onOptionsItemSelected()). Meme icone que le badge PR
         existant ailleurs dans l'app (ic_emoji_events_24px). -->
    <item
        android:id="@+id/rep_range_history"
        android:icon="@drawable/ic_emoji_events_24px"
        android:title="Personal Records"
        app:showAsAction="never"
        app:iconTint="@color/cardview_light_background">
    </item>


    <item
        android:id="@+id/timer"
        android:icon="@drawable/ic_alarm_24px"
        android:title="Timer"
        app:showAsAction="never"
        app:iconTint="@color/cardview_light_background">

    </item>

    <item
        android:id="@+id/comment"
        android:icon="@drawable/ic_comment_24px"
        android:title="Exercise Comments"
        app:showAsAction="never"
        app:iconTint="@color/cardview_light_background">

    </item>

    <!-- Retour Romain 05/09/2026 : sélection multiple pour supprimer plusieurs séries
         d'un coup, au lieu d'un "Clear" fastidieux série par série. Entre en mode
         sélection via une ActionMode (androidx.appcompat.view.ActionMode) plutôt que
         de réinterpréter le long-press existant, qui reste utilisé pour Éditer/Supprimer
         UNE série (menu popup existant, voir set_add_exercise_activity_menu.xml). -->
    <item
        android:id="@+id/select_sets"
        android:icon="@drawable/ic_fact_check_24px"
        android:title="Select sets"
        app:showAsAction="never"
        app:iconTint="@color/cardview_light_background">

    </item>








</menu>