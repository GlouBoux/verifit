<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:text="Timer"
        android:textColor="@color/colorPrimary"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </TextView>


    <View
        android:id="@+id/blue_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="@color/colorPrimary"
        app:layout_constraintTop_toBottomOf="@+id/tv_date"
        tools:layout_editor_absoluteX="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bt_close"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="100dp"
        android:layout_marginRight="100dp"
        android:layout_marginBottom="20dp"
        android:text="Reset"
        android:textAllCaps="false"
        android:textColor="@color/colorPrimary"
        app:backgroundTint="@color/core_white"
        app:cornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bt_start"
        app:layout_constraintTop_toBottomOf="@+id/cb_rest_timer_auto_start" />


    <EditText
        android:id="@+id/et_seconds"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="5dp"
        android:layout_marginRight="5dp"
        android:ems="10"
        android:gravity="center_horizontal"
        android:inputType="number"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/plus_seconds"
        app:layout_constraintStart_toEndOf="@+id/minus_seconds"
        app:layout_constraintTop_toBottomOf="@+id/blue_line"
        tools:text="60" />

    <ImageButton
        android:id="@+id/minus_seconds"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="100dp"
        android:layout_marginLeft="100dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="20dp"
        android:layout_marginRight="20dp"
        android:backgroundTint="@color/custom_button3"
        android:onClick="clickPlusWeight"
        android:tint="@color/colorPrimary"
        app:layout_constraintEnd_toStartOf="@+id/et_seconds"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blue_line"
        app:srcCompat="@drawable/ic_remove_24px" />

    <ImageButton
        android:id="@+id/plus_seconds"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="100dp"
        android:layout_marginRight="100dp"
        android:backgroundTint="@color/custom_button3"
        android:onClick="clickPlusWeight"
        android:tint="@color/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/et_seconds"
        app:layout_constraintTop_toBottomOf="@+id/blue_line"
        app:srcCompat="@drawable/ic_add_24px" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bt_start"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="100dp"
        android:layout_marginLeft="100dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="20dp"
        android:text="Start"
        android:textAllCaps="false"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/bt_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cb_rest_timer_auto_start" />

    <!-- Retour Romain 06/09/2026 : "il faudrait pouvoir ajuster le volume suivant le
         bruit ambiant du jour" (comme sur FitNotes) - regle le volume du bip joue par
         RestTimerReceiver (independant du volume "notifications" du telephone), lu/ecrit
         dans les memes SharedPreferences que la duree du minuteur. Voir
         AddExerciseActivity.setupTimer()/loadVolume()/RestTimerReceiver.VOLUME_PREF_KEY. -->
    <TextView
        android:id="@+id/tv_volume_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="25dp"
        android:text="Volume"
        android:textColor="@color/colorPrimary"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_seconds" />

    <SeekBar
        android:id="@+id/sb_volume"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="20dp"
        android:layout_marginRight="20dp"
        android:max="100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_volume_label" />

    <!-- Retour Romain 06/09/2026 : "le bip est un peu court, possible de le rendre 2
         fois plus long ? ou m'offrir la possibilite de l'editer dans l'app ?" - regle
         la duree du bip joue par RestTimerReceiver (synthetise a la volee, cf
         RestTimerReceiver.generateBeepSamples()). Le curseur va de MIN_DURATION_MS a
         MAX_DURATION_MS ; voir AddExerciseActivity.loadDuration()/saveDuration(). -->
    <TextView
        android:id="@+id/tv_beep_duration_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="25dp"
        android:text="Duree du bip"
        android:textColor="@color/colorPrimary"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sb_volume" />

    <SeekBar
        android:id="@+id/sb_beep_duration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="20dp"
        android:layout_marginRight="20dp"
        android:max="1850"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_beep_duration_label" />

    <!-- Retour Romain (fitnotes-fork-todo.md, "Nouvelles demandes" 06/09/2026) + feature
         FitNotes confirmee (fitnotes-features-workout-tools.md, "Auto Start") : demarre
         automatiquement le minuteur a chaque nouvelle serie loggee, tant qu'on reste sur
         l'exercice - voir AddExerciseActivity.autoStartRestTimerIfEnabled(). Desactive
         par defaut (voir REST_TIMER_AUTO_START_PREF_KEY). -->
    <CheckBox
        android:id="@+id/cb_rest_timer_auto_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:text="Auto Start"
        android:textColor="@color/core_black"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sb_beep_duration" />

</androidx.constraintlayout.widget.ConstraintLayout>