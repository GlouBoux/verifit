<?xml version="1.0" encoding="utf-8"?>
<!-- Root view of CalendarPickerDialog: a month header with prev/next buttons, a
     7-column grid of days (calendar_day_cell.xml) below it, and (Vague 3 du plan de
     migration, retour 08/09/2026, mode "Browse" uniquement - voir
     CalendarPickerDialog.enableBrowsingFeatures()) a second toolbar row for the
     Category/Exercise Filter and the List View toggle, plus the List View's
     RecyclerView itself (calendar_day_list_row.xml rows), hidden until toggled on.
     Replaces the plain Android DatePickerDialog previously opened from the toolbar's
     calendar icon.

     Vague IHM, IHM-3 (11/09/2026) : icones de navigation/outils de ce dialogue tintees
     en @color/colorPrimary - meme convention deja appliquee en IHM-1/IHM-2 (steppers
     +/- de l'ecran de saisie, icone commentaire) et chez FitNotes lui-meme (fleches
     precedent/suivant en bleu, ic_action_left_blue/right_blue). Rien d'autre change
     ici : structure et espacements identiques. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/calendar_prev_month"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_keyboard_arrow_left_24px"
            android:tint="@color/colorPrimary" />

        <TextView
            android:id="@+id/calendar_month_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/core_black"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="September 2026" />

        <ImageButton
            android:id="@+id/calendar_next_month"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_keyboard_arrow_right_24px"
            android:tint="@color/colorPrimary" />

    </LinearLayout>

    <!-- Barre Filter/List View - uniquement visible en mode Browse (calendrier ouvert
         depuis l'icone calendrier de l'accueil), jamais en mode "Pick a day"
         (Copy/Move Workout) ou un filtre/une liste n'a pas de sens. GONE par defaut,
         rendue visible par CalendarPickerDialog.enableBrowsingFeatures(). -->
    <LinearLayout
        android:id="@+id/calendar_browse_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageButton
            android:id="@+id/calendar_filter_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_fact_check_24px"
            android:tint="@color/colorPrimary" />

        <TextView
            android:id="@+id/calendar_filter_results"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/core_grey_55"
            android:textSize="12sp"
            tools:text="12 workouts found" />

        <ImageButton
            android:id="@+id/calendar_prev_match"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_keyboard_arrow_left_24px"
            android:tint="@color/colorPrimary"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/calendar_next_match"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_keyboard_arrow_right_24px"
            android:tint="@color/colorPrimary"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/calendar_toggle_list_view"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_view_compact_24px"
            android:tint="@color/colorPrimary" />

    </LinearLayout>

    <GridView
        android:id="@+id/calendar_day_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:horizontalSpacing="0dp"
        android:numColumns="7"
        android:stretchMode="columnWidth"
        android:verticalSpacing="4dp" />

    <!-- List View (Vague 3, retour 08/09/2026) - alternative a la grille mensuelle,
         liste chronologique (plus recent en premier) des seances, respectant le
         filtre actif s'il y en a un. GONE par defaut. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/calendar_day_list"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>
