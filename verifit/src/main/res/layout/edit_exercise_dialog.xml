<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="50dp"
        android:layout_marginRight="50dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Edit Exercise"
        android:textColor="@color/colorPrimary"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </TextView>


    <EditText
        android:id="@+id/et_exercise_name"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:layout_marginTop="30dp"
        android:ems="10"
        android:inputType="textPersonName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blue_line" />

    <Spinner
        android:id="@+id/spinner"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_exercise_name" />

    <!-- "Exercise Notes" (retour Romain 28/09/2026) : reutilise ce dialog aussi bien
         pour Edit (pre-rempli avec les notes existantes) que pour Duplicate (pre-rempli
         avec une copie des notes de la source, voir ExerciseAdapter) - voir
         claude/fitnotes-features-exercises.md §4. -->
    <TextView
        android:id="@+id/tv_notes_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Notes (optional):"
        android:textColor="@color/colorPrimary"
        app:layout_constraintStart_toStartOf="@+id/spinner"
        app:layout_constraintTop_toBottomOf="@+id/spinner" />

    <EditText
        android:id="@+id/et_exercise_notes"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="top|start"
        android:hint="Ex : hauteur banc = 3, amplitude partielle..."
        android:inputType="textMultiLine"
        android:minLines="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_notes_label" />

    <!-- Affichage assistance / lest (retour Romain 20/10/2026, voir AssistDisplay) :
         n'agit que sur l'affichage. La charge saisie et enregistree reste la charge
         effective (poids de corps de reference moins l'assistance, plus le lest). -->
    <CheckBox
        android:id="@+id/cb_assisted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Exercice assisté (afficher assistance / lest)"
        app:layout_constraintStart_toStartOf="@+id/et_exercise_notes"
        app:layout_constraintTop_toBottomOf="@+id/et_exercise_notes" />

    <LinearLayout
        android:id="@+id/ll_assist_options"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@+id/et_exercise_notes"
        app:layout_constraintTop_toBottomOf="@+id/cb_assisted">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginLeft="32dp"
            android:text="Réf. (kg)" />

        <EditText
            android:id="@+id/et_assist_ref"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:gravity="center_horizontal"
            android:inputType="numberDecimal" />

        <CheckBox
            android:id="@+id/cb_assist_per_side"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginLeft="12dp"
            android:text="par côté" />
    </LinearLayout>

    <!-- Retour Romain 14/10/2026 (harmonisation des boutons) : regle unique de l'app,
         action principale a DROITE, action secondaire/annulation a sa gauche (convention
         Android, deja suivie par les AlertDialog systeme). Ici : Save (ou Duplicate) a droite, Cancel a gauche.
         Seules les contraintes horizontales ont ete permutees, les id ne changent pas. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/bt_login_signup"
        style="@style/Widget.Verifit.Button.Flat"
        android:textColor="@color/colorPrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginEnd="100dp"
        android:layout_marginRight="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bt_cancel"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="30dp"
        android:text="Save"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_assist_options" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bt_cancel"
        style="@style/Widget.Verifit.Button.Flat"
        android:textColor="@color/colorPrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="100dp"
        android:layout_marginLeft="100dp"
        android:layout_marginEnd="10dp"
        android:layout_marginRight="10dp"
        app:layout_constraintEnd_toStartOf="@+id/bt_login_signup"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        android:text="Cancel"
        android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@+id/ll_assist_options" />

    <View
        android:id="@+id/blue_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="@color/colorPrimary"
        app:layout_constraintTop_toBottomOf="@+id/tv_date"
        tools:layout_editor_absoluteX="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>