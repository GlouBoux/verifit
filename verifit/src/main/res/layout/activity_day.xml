<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/core_grey_05"
    android:orientation="vertical"
    tools:context=".ui.DayActivity">

    <!-- Retour Romain 06/09/2026 : chrono de la SEANCE entiere - meme barre que sur
         AddExerciseActivity (voir ce layout pour le detail du commentaire), affichee
         aussi ici car c'est l'autre ecran ou Romain regarde sa seance en cours. Voir
         DayActivity.refreshSessionTimerBar()/showWorkoutTimeDialog().
         Retour Romain 07/09/2026 : icone course a pied et bouton Stop/Resume retires
         (voir activity_add_exercise.xml pour le detail) - un tap ouvre le dialogue
         "Workout Time", decompte seul et centre sur la barre elle-meme. -->
    <LinearLayout
        android:id="@+id/session_timer_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@color/core_grey_10"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_session_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/core_black"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="00:00:00" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton"
        style="@style/AppTheme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:clickable="true"
        android:tint="@color/core_white"
        app:backgroundTint="@color/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/recycler_view_day"
        app:rippleColor="@color/core_white"
        app:srcCompat="@drawable/ic_add_24px"
        app:tint="@color/core_white" />

    <!-- Commentaire de la seance entiere (Vague 3 du plan de migration, retour Romain
         07/09/2026) - meme champ que sur l'ecran d'accueil (item_view_pager.xml), voir
         ce layout pour le detail. GONE si aucun commentaire - voir
         DayActivity.initActivity(). -->
    <TextView
        android:id="@+id/tv_workout_comment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:textColor="@color/core_grey_55"
        android:textStyle="italic"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/session_timer_bar"
        tools:text="Great session, felt strong on bench"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_day"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_workout_comment"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout_editor_absoluteX="0dp" >

    </androidx.recyclerview.widget.RecyclerView>


</androidx.constraintlayout.widget.ConstraintLayout>