<?xml version="1.0" encoding="utf-8"?>
<!-- One cell of the CalendarPickerDialog's month grid: a day number (with a colored
     circle behind it when it's the selected day) and a small dot underneath when that
     day already has a logged workout. Filler cells (days outside the displayed month)
     are left blank and disabled by CalendarPickerDialog.DayGridAdapter. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="40dp">

    <TextView
        android:id="@+id/calendar_day_number"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:background="@drawable/calendar_day_number_background"
        android:gravity="center"
        android:textColor="@color/calendar_day_number_text_color"
        android:textSize="14sp"
        tools:text="15" />

    <View
        android:id="@+id/calendar_day_dot"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="2dp"
        android:background="@drawable/calendar_day_dot_shape" />

</FrameLayout>
