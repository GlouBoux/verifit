<?xml version="1.0" encoding="utf-8"?>
<!-- One row of CalendarPickerDialog's List View (Vague 3 du plan de migration, retour
     08/09/2026) - date header, then one line per exercise (colored category dot +
     exercise name + compact sets summary) added programmatically into
     calendar_list_row_exercises by CalendarPickerDialog.CalendarListAdapter, since the
     number of exercises varies per day. Tapping the whole row behaves like tapping a
     day in the month grid (same OnDaySelectedListener callback). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/calendar_list_row_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/core_black"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Monday 08 September 2026" />

    <LinearLayout
        android:id="@+id/calendar_list_row_exercises"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

</LinearLayout>
