<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.AddExerciseActivity">

    <!-- Retour Romain 06/09/2026 : "je ne sais ni ne peux controler ce timer [de la
         seance entiere, celui utilise dans le rapport de partage] [...] il faut que je
         puisse y acceder [...] je dois pouvoir le controler" - chrono de la SEANCE
         entiere (different du minuteur de repos entre les series juste en dessous).
         Demarre automatiquement a la premiere serie loggee, arrete manuellement via ce
         bouton (pas de reproduction des cases a cocher de FitNotes, non demandee) - voir
         AddExerciseActivity.refreshSessionTimerBar()/toggleSessionTimer() et le
         commentaire sur WorkoutDay.SessionStartTimestamp. Devient la seule source de la
         ligne "Time" de l'export de seance (WorkoutReportGenerator). -->
    <LinearLayout
        android:id="@+id/session_timer_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@color/core_grey_10"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            app:srcCompat="@drawable/ic_run_circle_24px"
            app:tint="@color/colorPrimary" />

        <TextView
            android:id="@+id/tv_session_timer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/core_black"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="00:00:00" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bt_session_timer_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Stop"
            android:textAllCaps="false"
            app:cornerRadius="10dp" />

    </LinearLayout>

    <!-- Retour Romain 06/09/2026 : "il faudrait que le timer de workout soit visible
         sur l'interface du workout en cours avec la possibilite de le declencher,
         l'arreter, le reset" - traumatisme FitNotes ou le timer continuait de tourner
         sans que ce soit visible (avant ce chantier, seul le dialogue "Timer" ouvert
         depuis le menu affichait l'etat du minuteur - une fois ferme, plus aucun
         retour visuel meme si le minuteur continuait de tourner en arriere-plan).
         Minuteur de REPOS entre les series (different du chrono de session ci-dessus) :
         barre persistante, toujours affichee en haut de cet ecran (sous le chrono de
         session) - lecture seule sauf Start/Pause et Reset - le reglage fin (duree
         exacte, volume, duree du bip) reste dans le dialogue complet (menu "Timer",
         inchange). Voir AddExerciseActivity.updateInlineTimerText()/onCreate(). -->
    <LinearLayout
        android:id="@+id/inline_timer_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@color/core_grey_05"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/session_timer_bar">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            app:srcCompat="@drawable/ic_alarm_24px"
            app:tint="@color/colorPrimary" />

        <TextView
            android:id="@+id/tv_inline_timer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/core_black"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="03:00" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bt_inline_timer_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Start"
            android:textAllCaps="false"
            app:cornerRadius="10dp" />

        <ImageButton
            android:id="@+id/bt_inline_timer_reset"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            app:srcCompat="@drawable/ic_replay_24px"
            app:tint="@color/colorPrimary" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/plus_reps"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="50dp"
        android:layout_marginRight="50dp"
        android:backgroundTint="@color/custom_button3"
        android:onClick="clickPlusReps"
        android:tint="@color/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/et_reps"
        app:layout_constraintTop_toBottomOf="@+id/view2"
        app:srcCompat="@drawable/ic_add_24px" />

    <ImageButton
        android:id="@+id/minus_reps"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginRight="10dp"
        android:backgroundTint="@color/custom_button3"
        android:onClick="clickMinusReps"
        android:tint="@color/colorPrimary"
        app:layout_constraintEnd_toStartOf="@+id/et_reps"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view2"
        app:srcCompat="@drawable/ic_remove_24px" />

    <View
        android:id="@+id/view2"
        android:layout_width="370dp"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:background="@color/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView4" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:text="Weight: "
        android:textColor="@color/core_black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/inline_timer_bar" />

    <View
        android:id="@+id/blue_line"
        android:layout_width="370dp"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:background="@color/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <EditText
        android:id="@+id/et_seconds"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:layout_marginRight="20dp"
        android:ems="10"
        android:gravity="center_horizontal"
        android:inputType="numberDecimal"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/plus_weight"
        app:layout_constraintStart_toEndOf="@+id/minus_weight"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <ImageButton
        android:id="@+id/minus_weight"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginRight="10dp"
        android:backgroundTint="@color/custom_button3"
        android:onClick="clickMinusWeight"
        android:tint="@color/colorPrimary"
        app:layout_constraintEnd_toStartOf="@+id/et_seconds"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blue_line"
        app:srcCompat="@drawable/ic_remove_24px" />

    <ImageButton
        android:id="@+id/plus_weight"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="50dp"
        android:layout_marginRight="50dp"
        android:backgroundTint="@color/custom_button3"
        android:onClick="clickPlusWeight"
        android:tint="@color/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/et_seconds"
        app:layout_constraintTop_toBottomOf="@+id/blue_line"
        app:srcCompat="@drawable/ic_add_24px" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:text="Reps:"
        android:textColor="@color/core_black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_seconds" />

    <EditText
        android:id="@+id/et_reps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:layout_marginRight="20dp"
        android:ems="10"
        android:gravity="center_horizontal"
        android:inputType="number"
        android:singleLine="false"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/plus_reps"
        app:layout_constraintStart_toEndOf="@+id/minus_reps"
        app:layout_constraintTop_toBottomOf="@+id/textView4" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bt_clear"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginRight="20dp"
        android:clickable="true"
        android:onClick="clickClear"
        android:text="Clear"
        android:textAllCaps="false"
        android:textColor="@color/colorPrimary"
        app:backgroundTint="@color/core_white"
        app:cornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bt_login_signup"
        app:layout_constraintTop_toBottomOf="@+id/et_reps" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bt_login_signup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="5dp"
        android:layout_marginRight="5dp"
        android:clickable="true"
        android:onClick="clickSave"
        android:text="Save"
        android:textAllCaps="false"
        android:textColor="@color/core_white"
        app:cornerRadius="10dp"
        app:layout_constraintEnd_toStartOf="@+id/bt_clear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_reps" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bt_login_signup">

    </androidx.recyclerview.widget.RecyclerView>


</androidx.constraintlayout.widget.ConstraintLayout>