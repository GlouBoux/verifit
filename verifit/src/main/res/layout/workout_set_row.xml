<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraint_day"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardview_set"
        style="@style/CardView.Light"
        android:backgroundTint="@color/custom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/exercise_constraint_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <CheckBox
                android:id="@+id/set_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:clickable="false"
                android:focusable="false"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:text="300"
                android:textColor="@color/core_black"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:text="kg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_date"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/set_reps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_marginRight="5dp"
                android:text="20"
                android:textColor="@color/core_black"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/textView7"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="40dp"
                android:layout_marginRight="40dp"
                android:text="reps"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/set_comment_indicator"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="12dp"
                android:layout_marginRight="12dp"
                android:visibility="gone"
                android:contentDescription="@null"
                android:src="@drawable/ic_comment_24px"
                app:tint="@color/colorPrimary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Badge discret "Ecart Prevu/Realise" (retour Romain 06/09/2026) : visible
                 uniquement quand le realise (reps/weight) d'une serie importee differe de
                 sa valeur prevue a l'import. Un tap dessus ouvre le detail Prevu/Realise. -->
            <ImageView
                android:id="@+id/set_discrepancy_badge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:layout_marginRight="8dp"
                android:visibility="gone"
                android:contentDescription="@null"
                android:src="@drawable/ic_error_outline_24px"
                app:tint="@color/red"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/set_comment_indicator"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Retour Romain 11/09/2026 : le badge PR d'origine (chaine avec les badges
                 commentaire/ecart a droite) chevauchait le mot "reps" des que 2-3 badges
                 etaient visibles en meme temps sur la meme ligne. Deplace ici, ancre sur
                 une Guideline a position FIXE (independante de la largeur du nombre de
                 reps, qui est lui-meme ancre par sa DROITE - width wrap_content - et
                 grandit donc vers la GAUCHE entre 1 et 2+ chiffres) : contrairement a un
                 ancrage relatif a set_reps, la position du trophee ne bouge jamais, que
                 ce soit 1 ou 11 reps. Place dans l'espace vide entre le bloc poids/kg et
                 le nombre de reps. -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_pr_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="130dp" />

            <!-- Badge "Personal Record" (Vague IHM, IHM-2, retour Romain 11/09/2026 :
                 "ajoute le badge PR") - visible quand cette serie est un record reel pour
                 son nombre de reps exact (DataStorage.getRepRangePRSets(), meme logique
                 que le tag "[PR]" deja utilise par l'export texte de seance - aucune
                 nouvelle regle de detection, juste un nouvel affichage). Trophee comme
                 FitNotes (Training_Track_Filled_With_Comments_Annotated.png). -->
            <ImageView
                android:id="@+id/set_pr_badge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:visibility="gone"
                android:contentDescription="@null"
                android:src="@drawable/ic_emoji_events_24px"
                app:tint="@color/core_yellow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/guideline_pr_badge"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/blue_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:background="@color/core_grey_02"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_date" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>