<PreferenceScreen xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Offline Settings">

        <Preference
            app:key="importcsv"
            app:summary="Import a previous backup from phone storage"
            app:title="Import"
            app:useSimpleSummaryProvider="false" />

        <Preference
            app:key="exportcsv"
            app:summary="Export to phone storage"
            app:title="Export"
            app:useSimpleSummaryProvider="false" />

        <!-- Export JSON dedie au pipeline Coaching (retour Romain 24/09/2026, voir
             claude/verifit-migration-plan.md story 2.2) - complement de "Export"
             (CSV) ci-dessus, meme dossier Documents/FitEngine. -->
        <Preference
            app:key="exportjson"
            app:summary="Export to phone storage (for Coaching)"
            app:title="Export JSON"
            app:useSimpleSummaryProvider="false" />

        <!-- Backup complet (point 1.4 de la revue d'architecture du 28/09/2026) : tout ce
             que l'app sauvegarde (voir BackupManager), contrairement au CSV ci-dessus.
             Des copies automatiques sont aussi faites dans Documents/FitEngine/auto. -->
        <Preference
            app:key="exportfullbackup"
            app:summary="Tout exporter (séances, prévu, chrono, supersets, objectifs, notes) dans Documents/FitEngine"
            app:title="Backup complet"
            app:useSimpleSummaryProvider="false" />

        <Preference
            app:key="importfullbackup"
            app:summary="Remplace toutes les données. Copies automatiques dans Documents/FitEngine/auto"
            app:title="Restaurer un backup complet"
            app:useSimpleSummaryProvider="false" />

        <Preference
            app:key="deletedata"
            app:summary="Delete all app workout data"
            app:title="Clear Data"
            app:useSimpleSummaryProvider="false" />

    </PreferenceCategory>

    <PreferenceCategory app:title="General">

        <!-- Retour Romain 16/09/2026 : bouton Light/Dark/Système comme FitNotes.
             Preference existait deja en commentaire (placeholder), remplacee ici par
             une vraie ListPreference. Persiste automatiquement dans les preferences
             par defaut de l'app (androidx.preference) sous la cle "theme" - lue par
             ThemeHelper au demarrage (VerifitApplication) et appliquee immediatement
             au changement (SettingsActivity). -->
        <ListPreference
            app:key="theme"
            app:title="Theme"
            app:entries="@array/theme_entries"
            app:entryValues="@array/theme_values"
            app:defaultValue="system"
            app:useSimpleSummaryProvider="true" />

        <!-- Retour Romain 28/09/2026 : afficher un numero de build pour ne plus avoir a
             se demander si on teste la bonne version de l'app. Summary pose
             dynamiquement dans SettingsActivity.onCreatePreferences() (versionName +
             horodatage de compilation, voir BuildConfig.BUILD_TIMESTAMP dans
             build.gradle) - la valeur ci-dessous n'est qu'un texte de secours tant que
             ce code ne s'est pas encore execute. -->
        <Preference
            app:key="version"
            app:summary="..."
            app:title="Version"
            app:useSimpleSummaryProvider="false" />

        <Preference
            app:key="licence"
            app:summary="GNU General Public Licence, version 3"
            app:title="Licence"
            app:useSimpleSummaryProvider="false" />

    </PreferenceCategory>

</PreferenceScreen>