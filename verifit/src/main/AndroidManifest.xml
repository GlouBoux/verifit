<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.verifit" >

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Retour Romain 06/09/2026 : minuteur de repos fiable meme telephone verrouille.
         Correctif 06/09/2026 (crash au demarrage du timer) : contrairement a ce qui
         etait suppose au premier jet, setAlarmClock() N'EST PAS exempte de
         SCHEDULE_EXACT_ALARM - sans cette permission declaree, l'appel levait une
         SecurityException non rattrapee qui faisait planter toute l'app. Permission
         "speciale" (Alarmes et rappels) auto-accordee a l'installation pour une app
         dont le targetSdkVersion est <= 31 (cas present), donc pas d'ecran de
         permission supplementaire pour Romain. VIBRATE pour la vibration de la
         notification de fin de repos (RestTimerReceiver). Pas besoin de
         POST_NOTIFICATIONS : targetSdkVersion 31 accorde les notifications a
         l'installation (seuil de cette exigence : 33). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true" >
        <activity
            android:name=".ui.ChangePasswordActivity"
            android:label="Reset Password"
            android:parentActivityName=".ui.ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ForgotPasswordActivity"
            android:exported="false"
            android:label="Forgot Password"
            android:parentActivityName=".ui.LoginActivity" />
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:parentActivityName=".ui.SettingsActivity"/>

        <service android:name=".BackupService" />

        <!-- Retour Romain 06/09/2026 : recoit l'alarme systeme programmee par
             AddExerciseActivity.scheduleTimerAlarm() a la fin du minuteur de repos -
             son + vibration + notification, meme app fermee ou telephone verrouille.
             exported=false : ne peut etre declenche que par l'app elle-meme via son
             PendingIntent, jamais par une autre app. -->
        <receiver android:name=".RestTimerReceiver" android:exported="false" />
        <activity
            android:name=".ui.ChartsActivity"
            android:label="Charts" />
        <activity
            android:name=".ui.CustomExerciseActivity"
            android:label="New Exercise" />
        <activity
            android:name=".ui.ExercisesActivity"
            android:label="Exercises" />
        <activity
            android:name=".ui.DayActivity"
            android:parentActivityName=".ui.DiaryActivity"
            android:label="Day" />
        <activity
            android:name=".ui.SettingsActivity"
            android:label="Settings"
            android:parentActivityName=".ui.MainActivity" />
        <activity
            android:name=".ui.CalculatorActivity"
            android:label="Plate Calculator" />
        <activity
            android:name=".ui.PersonalRecordsActivity"
            android:label="Personal Records"
            android:parentActivityName=".ui.ChartsActivity" />
        <activity
            android:name=".ui.DiscrepancyHistoryActivity"
            android:label="Ecarts Prevu/Realise"
            android:parentActivityName=".ui.ChartsActivity" />
        <activity
            android:name=".ui.RepRangeRecordsActivity"
            android:label="Historique par nombre de reps"
            android:parentActivityName=".ui.PersonalRecordsActivity" />
        <activity
            android:name=".ui.AddExerciseActivity"
            android:label="Add Exercise" />
        <activity
            android:name=".ui.DiaryActivity"
            android:label="Sessions" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>