<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.verifit" >

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- Retour Romain 06/09/2026 : minuteur de repos fiable meme telephone verrouille.
         Correctif 06/09/2026 (crash au demarrage du timer) : contrairement a ce qui
         etait suppose au premier jet, setAlarmClock() N'EST PAS exempte de
         SCHEDULE_EXACT_ALARM - sans cette permission declaree, l'appel levait une
         SecurityException non rattrapee qui faisait planter toute l'app. Permission
         "speciale" (Alarmes et rappels) auto-accordee a l'installation pour une app
         dont le targetSdkVersion est <= 31 (cas present), donc pas d'ecran de
         permission supplementaire pour Romain. VIBRATE pour la vibration de la
         notification de fin de repos (RestTimerReceiver). Pas besoin de
         POST_NOTIFICATIONS : targetSdkVersion 31 accorde les notifications a
         l'installation (seuil de cette exigence : 33). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".VerifitApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme" >
        <!-- Retour Romain 06/09/2026 : recoit l'alarme systeme programmee par
             AddExerciseActivity.scheduleTimerAlarm() a la fin du minuteur de repos -
             son + vibration + notification, meme app fermee ou telephone verrouille.
             exported=false : ne peut etre declenche que par l'app elle-meme via son
             PendingIntent, jamais par une autre app. -->
        <receiver android:name=".RestTimerReceiver" android:exported="false" />
        <activity
            android:name=".ui.ChartsActivity"
            android:label="Charts" />
        <activity
            android:name=".ui.CustomExerciseActivity"
            android:label="New Exercise" />
        <activity
            android:name=".ui.ExercisesActivity"
            android:label="Exercises" />
        <activity
            android:name=".ui.DayActivity"
            android:parentActivityName=".ui.DiaryActivity"
            android:label="Day" />
        <activity
            android:name=".ui.SettingsActivity"
            android:label="Settings"
            android:parentActivityName=".ui.MainActivity" />
        <activity
            android:name=".ui.PersonalRecordsActivity"
            android:label="Personal Records"
            android:parentActivityName=".ui.ChartsActivity" />
        <!-- "Goals" (Vague 4 du plan de migration, item 14, retour Romain 08/09/2026 :
             "passe a la vague 4"). -->
        <activity
            android:name=".ui.GoalsActivity"
            android:label="Goals"
            android:parentActivityName=".ui.PersonalRecordsActivity" />
        <activity
            android:name=".ui.DiscrepancyHistoryActivity"
            android:label="Ecarts Prevu/Realise"
            android:parentActivityName=".ui.ChartsActivity" />
        <activity
            android:name=".ui.RepRangeRecordsActivity"
            android:label="Historique par nombre de reps"
            android:parentActivityName=".ui.PersonalRecordsActivity" />
        <activity
            android:name=".ui.AddExerciseActivity"
            android:label="Add Exercise" />
        <activity
            android:name=".ui.DiaryActivity"
            android:label="Sessions" />
        <!-- Lot D (D7, 02/10/2026) : "Ouvrir avec FitEngine" - recoit une seance JSON
             depuis Drive, un mail, Discord ou un fichier telecharge, et en montre l'apercu
             (voir ImportSessionActivity). VIEW = ouvrir un fichier, SEND = partager un
             fichier ou un texte. Les types texte et octet-stream sont acceptes parce que
             les applis ne declarent pas toutes un fichier .json en application/json ; un
             fichier qui n'est pas une seance affiche simplement une erreur. exported=true
             obligatoire pour etre propose par les autres applis : l'ecran ne modifie rien
             tant que l'utilisateur n'a pas appuye sur "Importer". -->
        <activity
            android:name=".ui.ImportSessionActivity"
            android:exported="true"
            android:label="Importer une séance" >
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/json" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/json" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>