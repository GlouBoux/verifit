# Gradle files
.gradle/
build/

# Trouve le 16/09/2026 dans verifit/ : sorties de build (App Bundles debug/release)
# et un dossier bin/ qui duplique tout le module (src/, build.gradle, .idea...) -
# probablement un vieux export/artefact IDE, jamais couvert par .gitignore jusqu'ici.
verifit/bin/
verifit/debug/
verifit/release/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log
build_log*.txt

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.apk
output.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Doc-editing lock files left behind by Claude's document tooling
docs/.*.lock
